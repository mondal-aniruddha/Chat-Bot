# Environment variables for Voice Assistant overrides
# Copy this file to .env for local customization

# General
ASSISTANT_NAME="Assistant"
VOICE_ASSISTANT_LOG_LEVEL="INFO"

# LLM Provider: internet (Free instant knowledge), gemini, openai, claude, ollama, rule_based
LLM_PROVIDER="internet"

# Google Gemini (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI or Compatible API (ChatGPT)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude API
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-haiku-20241022"

# Ollama Local LLM (Optional)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Speech-to-Text
STT_MODEL_SIZE="tiny"

# Text-to-Speech
TTS_VOICE_RATE=190
TTS_VOICE_VOLUME=1.0
