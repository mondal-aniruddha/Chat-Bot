# Environment variables for Voice Assistant overrides
# Copy this file to .env for local customization

# General
ASSISTANT_NAME="Assistant"
VOICE_ASSISTANT_LOG_LEVEL="INFO"

# LLM Providers (Optional for offline mode)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# OpenAI or Compatible API (Optional)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Speech-to-Text
STT_MODEL_SIZE="tiny"

# Text-to-Speech
TTS_VOICE_RATE=190
TTS_VOICE_VOLUME=1.0
